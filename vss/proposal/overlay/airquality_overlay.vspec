#
# VSS OVERLAY: air quality signals for cabin and exterior air.
#
# This is the overlay (non-fork) form of the air-quality proposal in
# ../files/AirComposition.vspec. It adds the same signals on top of an
# UNMODIFIED VSS standard catalog using the official VSS overlay mechanism
# (https://covesa.github.io/vehicle_signal_specification/extensions/overlay/).
#
# Usage (with vss-tools >= 6, from a VSS checkout):
#
#   vspec export json \
#     -u ./spec/units.yaml      -u path/to/units_airquality.yaml \
#     -q ./spec/quantities.yaml -q path/to/quantities_airquality.yaml \
#     --strict \
#     -s ./spec/VehicleSignalSpecification.vspec \
#     -l path/to/airquality_overlay.vspec \
#     -o vss_with_airquality.json
#
# The extra unit/quantity files are required because the VSS standard catalog
# currently defines NO concentration units (no ppm, ppb, or ug/m^3 --
# verified against VSS master, v6.0, and v5.1 on 2026-07-27).

Vehicle:
  type: branch

Vehicle.Cabin:
  type: branch

Vehicle.Cabin.AirQuality:
  type: branch
  description: Signals describing the composition of the air inside the vehicle cabin.

Vehicle.Cabin.AirQuality.PM1:
  datatype: float
  type: sensor
  unit: ug/m^3
  min: 0
  description: Mass concentration of particulate matter with aerodynamic diameter
               of 1 micrometer or less (PM1.0).

Vehicle.Cabin.AirQuality.PM25:
  datatype: float
  type: sensor
  unit: ug/m^3
  min: 0
  description: Mass concentration of particulate matter with aerodynamic diameter
               of 2.5 micrometers or less (PM2.5).

Vehicle.Cabin.AirQuality.PM10:
  datatype: float
  type: sensor
  unit: ug/m^3
  min: 0
  description: Mass concentration of particulate matter with aerodynamic diameter
               of 10 micrometers or less (PM10).

Vehicle.Cabin.AirQuality.CO2:
  datatype: float
  type: sensor
  unit: ppm
  min: 0
  description: Carbon dioxide (CO2) concentration.
  comment: If the sensor reports an estimated CO2 level (eCO2/CO2eq) derived from
           other gas measurements rather than a direct CO2 measurement, the
           estimated value may be reported here.

Vehicle.Cabin.AirQuality.NO2:
  datatype: float
  type: sensor
  unit: ppb
  min: 0
  description: Nitrogen dioxide (NO2) concentration.

Vehicle.Cabin.AirQuality.Ozone:
  datatype: float
  type: sensor
  unit: ppb
  min: 0
  description: Ozone (O3) concentration.

Vehicle.Cabin.AirQuality.TVOC:
  datatype: float
  type: sensor
  unit: ppb
  min: 0
  description: Total volatile organic compounds (TVOC) concentration.

Vehicle.Exterior:
  type: branch

Vehicle.Exterior.AirQuality:
  type: branch
  description: Signals describing the composition of the ambient air outside the vehicle.

Vehicle.Exterior.AirQuality.PM1:
  datatype: float
  type: sensor
  unit: ug/m^3
  min: 0
  description: Mass concentration of particulate matter with aerodynamic diameter
               of 1 micrometer or less (PM1.0).

Vehicle.Exterior.AirQuality.PM25:
  datatype: float
  type: sensor
  unit: ug/m^3
  min: 0
  description: Mass concentration of particulate matter with aerodynamic diameter
               of 2.5 micrometers or less (PM2.5).

Vehicle.Exterior.AirQuality.PM10:
  datatype: float
  type: sensor
  unit: ug/m^3
  min: 0
  description: Mass concentration of particulate matter with aerodynamic diameter
               of 10 micrometers or less (PM10).

Vehicle.Exterior.AirQuality.CO2:
  datatype: float
  type: sensor
  unit: ppm
  min: 0
  description: Carbon dioxide (CO2) concentration.

Vehicle.Exterior.AirQuality.NO2:
  datatype: float
  type: sensor
  unit: ppb
  min: 0
  description: Nitrogen dioxide (NO2) concentration.

Vehicle.Exterior.AirQuality.Ozone:
  datatype: float
  type: sensor
  unit: ppb
  min: 0
  description: Ozone (O3) concentration.

Vehicle.Exterior.AirQuality.TVOC:
  datatype: float
  type: sensor
  unit: ppb
  min: 0
  description: Total volatile organic compounds (TVOC) concentration.
